{
  "name": "logic-simulator-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "launch": "node launcher.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "broker:smoke": "node ./validation/api_anbindung/run-broker-ui-smoke.mjs",
    "broker:smoke:recovery": "node ./validation/api_anbindung/run-broker-ui-smoke.mjs --scenario stale-session-recovery",
    "broker:smoke:rate-limit": "node ./validation/api_anbindung/run-broker-ui-smoke.mjs --scenario rate-limit-session-key",
    "broker:smoke:chat-rate-limit": "node ./validation/api_anbindung/run-broker-ui-smoke.mjs --scenario rate-limit-chat-request",
    "broker:smoke:reset-rate-limit": "node ./validation/api_anbindung/run-broker-ui-smoke.mjs --scenario rate-limit-chat-reset",
    "broker:smoke:config-error": "node ./validation/api_anbindung/run-broker-ui-smoke.mjs --scenario config-invalid-base-url",
    "broker:smoke:policy-block": "node ./validation/api_anbindung/run-broker-ui-smoke.mjs --scenario policy-chat-blocked",
    "broker:smoke:provider-error": "node ./validation/api_anbindung/run-broker-ui-smoke.mjs --scenario provider-upstream-unavailable",
    "contract:test": "vite-node validation/run-contract-runner.mjs",
    "golden:test": "vite-node validation/run-golden-corpus-v1.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "puppeteer": "^25.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "flatted": "^3.4.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^10.2.6"
    }
  }
}
