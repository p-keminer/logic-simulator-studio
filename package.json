{
  "name": "logic-simulator-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "launch": "node launcher.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "preview": "vite preview",
    "snapshot:sync": "node ./scripts/build-snapshot.mjs",
    "roadmap:compl": "npm run snapshot:sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "broker:smoke": "node ./validation/api_anbindung/run-broker-ui-smoke.mjs",
    "broker:smoke:recovery": "BROKER_UI_SMOKE_SCENARIO=stale-session-recovery node ./validation/api_anbindung/run-broker-ui-smoke.mjs",
    "broker:smoke:rate-limit": "BROKER_UI_SMOKE_SCENARIO=rate-limit-session-key node ./validation/api_anbindung/run-broker-ui-smoke.mjs",
    "broker:smoke:chat-rate-limit": "BROKER_UI_SMOKE_SCENARIO=rate-limit-chat-request node ./validation/api_anbindung/run-broker-ui-smoke.mjs",
    "broker:smoke:reset-rate-limit": "BROKER_UI_SMOKE_SCENARIO=rate-limit-chat-reset node ./validation/api_anbindung/run-broker-ui-smoke.mjs",
    "broker:smoke:config-error": "BROKER_UI_SMOKE_SCENARIO=config-invalid-base-url node ./validation/api_anbindung/run-broker-ui-smoke.mjs",
    "broker:smoke:policy-block": "BROKER_UI_SMOKE_SCENARIO=policy-chat-blocked node ./validation/api_anbindung/run-broker-ui-smoke.mjs",
    "broker:smoke:provider-error": "BROKER_UI_SMOKE_SCENARIO=provider-upstream-unavailable node ./validation/api_anbindung/run-broker-ui-smoke.mjs",
    "contract:test": "vite-node validation/run-contract-runner.mjs",
    "golden:test": "vite-node validation/run-golden-corpus-v1.mjs"
  },
  "dependencies": {
    "puppeteer": "^24.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-node": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "eslint": {
      "minimatch": "^3.1.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^10.2.4"
    }
  }
}
