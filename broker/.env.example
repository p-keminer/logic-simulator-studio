# Logic Simulator Studio – Broker Konfiguration
# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env-Datei wird NICHT ins Git-Repo eingecheckt (.gitignore).
#
# Hinweis: Den eigenen API-Key trägst du NICHT hier ein.
# Er wird zur Laufzeit im Frontend-Broker-Modal eingegeben und
# nur im Arbeitsspeicher der laufenden Session gehalten.

# ── Server ───────────────────────────────────────────────────────────────────
APP_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Komma-getrennte Liste erlaubter Frontend-Origins für CORS.
# Leer lassen in development → Standard: http://localhost:5173, http://127.0.0.1:5173
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Wie lange eine Session gültig bleibt (in Sekunden). Standard: 900 (15 Min)
# SESSION_TTL_SECONDS=900

# Optionale Speichergrenzen. Die Standardwerte genügen normalerweise.
# RATE_LIMIT_MAX_BUCKETS=10000
# SESSION_STORE_MAX_RECORDS=1024
# SESSION_STORE_INACTIVE_RETENTION_SECONDS=3600
# CONVERSATION_STORE_MAX_RECORDS=256
# CONVERSATION_MAX_STORED_BYTES=262144
# CONVERSATION_IDLE_TTL_SECONDS=3600
# AUDIT_STORE_MAX_EVENTS=2048
# AUDIT_STORE_RETENTION_SECONDS=86400
# METRICS_STORE_MAX_SERIES=512
# METRICS_STORE_MAX_SAMPLES=2048
# METRICS_SAMPLE_RETENTION_SECONDS=3600

# Künstliche Antwortverzögerung für Entwicklung (ms). Nur in development wirksam.
# DEV_RESPONSE_DELAY_MS=0

# ── Provider-Konfiguration ───────────────────────────────────────────────────
# Welcher KI-Provider-Client aktiv ist:
#   noop              → kein echter API-Call (Standard, sicher für Entwicklung)
#   anthropic         → direkte Anthropic API (api.anthropic.com)
#   openai-compatible → OpenAI-Format, konfigurierbare Base-URL
#                       (OpenAI, OpenRouter, Ollama, ...)
PROVIDER=noop

# Pflicht für PROVIDER=openai-compatible. Beispiele:
#   OpenAI:     https://api.openai.com
#   OpenRouter: https://openrouter.ai/api
#   Ollama:     http://localhost:11434
# PROVIDER_BASE_URL=https://openrouter.ai/api

# Standard-Modell das an den Provider gesendet wird. Beispiele:
#   Anthropic:    claude-opus-4-6
#   OpenAI:       gpt-4o
#   OpenRouter:   anthropic/claude-opus-4-6
# PROVIDER_DEFAULT_MODEL=minimax/minimax-m2.7

# HTTP-Timeout pro Provider-Request in Millisekunden. Standard: 30000 (30 s)
# PROVIDER_TIMEOUT_MS=30000

# Maximale Retry-Versuche bei transienten Fehlern. Standard: 2
# PROVIDER_MAX_ATTEMPTS=2
