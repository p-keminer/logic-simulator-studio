# Logic Simulator Studio – Broker Konfiguration
# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env-Datei wird NICHT ins Git-Repo eingecheckt (.gitignore).
#
# Hinweis: Den eigenen API-Key traegst du NICHT hier ein.
# Er wird zur Laufzeit im Frontend-Broker-Modal eingegeben und
# nur im Arbeitsspeicher der laufenden Session gehalten.

# ── Server ───────────────────────────────────────────────────────────────────
APP_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Komma-getrennte Liste erlaubter Frontend-Origins fuer CORS.
# Leer lassen in development → Standard: http://localhost:5173, http://127.0.0.1:5173
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Wie lange eine Session gueltig bleibt (in Sekunden). Standard: 900 (15 Min)
# SESSION_TTL_SECONDS=900

# Kuenstliche Antwortverzoegerung fuer Entwicklung (ms). Nur in development wirksam.
# DEV_RESPONSE_DELAY_MS=0

# ── Staging-Access-Gate ──────────────────────────────────────────────────────
# Nur relevant wenn APP_ENV=staging. Bewacht alle /v1/*-Routen.
# Mindestlaenge 32 Zeichen. Erzeugen mit: openssl rand -hex 32
# NIEMALS ins Git-Repo einchecken – nur als Render-Secret oder lokale Env-Var.
# STAGING_ACCESS_TOKEN=

# ── Provider-Konfiguration ───────────────────────────────────────────────────
# Welcher KI-Provider-Client aktiv ist:
#   noop              → kein echter API-Call (Standard, sicher fuer Entwicklung)
#   anthropic         → direkte Anthropic API (api.anthropic.com)
#   openai-compatible → OpenAI-Format, konfigurierbare Base-URL
#                       (OpenAI, OpenRouter, Ollama, ...)
PROVIDER=noop

# Pflicht fuer PROVIDER=openai-compatible. Beispiele:
#   OpenAI:     https://api.openai.com
#   OpenRouter: https://openrouter.ai/api
#   Ollama:     http://localhost:11434
# PROVIDER_BASE_URL=https://openrouter.ai

# Standard-Modell das an den Provider gesendet wird. Beispiele:
#   Anthropic:    claude-opus-4-6
#   OpenAI:       gpt-4o
#   OpenRouter:   anthropic/claude-opus-4-6
# PROVIDER_DEFAULT_MODEL=

# HTTP-Timeout pro Provider-Request in Millisekunden. Standard: 30000 (30 s)
# PROVIDER_TIMEOUT_MS=30000

# Maximale Retry-Versuche bei transienten Fehlern. Standard: 2
# PROVIDER_MAX_ATTEMPTS=2
