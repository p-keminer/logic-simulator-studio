{
  "$schema": "../gate-contract-schema.json",
  "schemaVersion": "1.0",
  "typeId": "BIN_CTR7S",
  "label": "BIN-CTR",
  "category": "output",

  "semantics": {
    "timingModel": "edge-triggered-rising",
    "clockEdge": "rising",
    "clockInputId": "clk",
    "asyncControls": [],
    "stateVariables": ["count", "prevClk"],
    "hasStableUndefinedState": false,
    "notes": "4-bit binary counter with integrated 7-segment display output. Counts 0–15 on each rising clock edge. RCO (ripple carry out) pulses high when count=15. Display segments driven directly from count state."
  },

  "ports": {
    "inputs": [
      { "id": "clk", "label": "CLK", "role": "clock", "activeLow": false, "defaultValue": 0 },
      { "id": "rst", "label": "RST", "role": "async-reset", "activeLow": false, "defaultValue": 0 },
      { "id": "en",  "label": "EN",  "role": "enable", "activeLow": false, "defaultValue": 0 }
    ],
    "outputs": [
      { "id": "q0", "label": "Q0", "role": "q",               "canBeTriState": false },
      { "id": "q1", "label": "Q1", "role": "q",               "canBeTriState": false },
      { "id": "q2", "label": "Q2", "role": "q",               "canBeTriState": false },
      { "id": "q3", "label": "Q3", "role": "q",               "canBeTriState": false },
      { "id": "rco", "label": "RCO", "role": "ripple-carry", "canBeTriState": false }
    ]
  },

  "signalModel": {
    "allowedInputValues": [0, 1],
    "allowedOutputValues": [0, 1],
    "hiZInputHandling": "treated-as-0",
    "busCapable": false
  },

  "exportSupport": {
    "verilog": "full",
    "vhdl": "full",
    "verilogNotes": "verilogExtraRegs: cnt[3:0] internal counter. always @(posedge clk) if (rst) cnt<=0; elsif (en) begin if (cnt==4'd15) cnt<=0; else cnt<=cnt+1; end",
    "vhdlNotes": "process(clk, rst) ... end process;",
    "verilogExtraRegs": true,
    "vhdlExtraSignals": true
  },

  "testability": {
    "requiredPatterns": [
      "counter-rollover",
      "clock-edge-detection",
      "hold-state",
      "reset-to-known-state",
      "sequential-step-sequence",
      "export-verilog",
      "export-vhdl"
    ],
    "notes": "Verify counter 0→1→...→15→0 rollover. Verify RCO pulses at count=15. Verify rst resets to 0."
  },

  "risks": [],
  "modelLimits": [
    "Display segments are UI-only output, not part of HDL export.",
    "RCO is combinational output derived from count."
  ]
}
