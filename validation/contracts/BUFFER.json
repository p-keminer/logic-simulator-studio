{
  "$schema": "../gate-contract-schema.json",
  "schemaVersion": "1.0",
  "typeId": "BUFFER",
  "label": "Buffer",
  "category": "logic_basic",

  "semantics": {
    "timingModel": "combinational",
    "clockEdge": "none",
    "clockInputId": null,
    "asyncControls": [],
    "stateVariables": [],
    "hasStableUndefinedState": false,
    "notes": "Non-inverting buffer. Output equals input."
  },

  "ports": {
    "inputs": [
      { "id": "a", "label": "A", "role": "data", "activeLow": false, "defaultValue": 0 }
    ],
    "outputs": [
      { "id": "out", "label": "Y", "role": "data", "canBeTriState": false }
    ]
  },

  "signalModel": {
    "allowedInputValues": [0, 1],
    "allowedOutputValues": [0, 1],
    "hiZInputHandling": "treated-as-0",
    "busCapable": false
  },

  "exportSupport": {
    "verilog": "full",
    "vhdl": "full",
    "verilogNotes": "assign out = a;",
    "vhdlNotes": "out <= a;",
    "verilogExtraRegs": false,
    "vhdlExtraSignals": false
  },

  "testability": {
    "requiredPatterns": [
      "truth-table-exhaustive",
      "export-verilog",
      "export-vhdl"
    ],
    "notes": "Truth table: 0→0, 1→1."
  },

  "risks": [],
  "modelLimits": [
    "No propagation delay (combinational, instantaneous).",
    "No Hi-Z handling — floating input treated as 0."
  ]
}
