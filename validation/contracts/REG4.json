{
  "$schema": "../gate-contract-schema.json",
  "schemaVersion": "1.0",
  "typeId": "REG4",
  "label": "REG4",
  "category": "register",

  "semantics": {
    "timingModel": "edge-triggered-rising",
    "clockEdge": "rising",
    "clockInputId": "clk",
    "asyncControls": [
      { "portId": "rst", "effect": "reset", "activeLevel": 1, "activeLow": false }
    ],
    "stateVariables": ["q0", "q1", "q2", "q3", "prevClk"],
    "hasStableUndefinedState": false,
    "notes": "4-bit parallel-load register with enable and async reset. clk↑+en=1 → q←d. rst=1 → all q=0 immediately (async). en=0 → hold."
  },

  "ports": {
    "inputs": [
      { "id": "d0",  "label": "D0",  "role": "data",   "activeLow": false, "defaultValue": 0 },
      { "id": "d1",  "label": "D1",  "role": "data",   "activeLow": false, "defaultValue": 0 },
      { "id": "d2",  "label": "D2",  "role": "data",   "activeLow": false, "defaultValue": 0 },
      { "id": "d3",  "label": "D3",  "role": "data",   "activeLow": false, "defaultValue": 0 },
      { "id": "en",  "label": "EN",  "role": "enable", "activeLow": false, "defaultValue": 0 },
      { "id": "clk", "label": "CLK", "role": "clock",  "activeLow": false, "defaultValue": 0 },
      { "id": "rst", "label": "RST", "role": "async-reset", "activeLow": false, "defaultValue": 0 }
    ],
    "outputs": [
      { "id": "q0", "label": "Q0", "role": "q", "canBeTriState": false },
      { "id": "q1", "label": "Q1", "role": "q", "canBeTriState": false },
      { "id": "q2", "label": "Q2", "role": "q", "canBeTriState": false },
      { "id": "q3", "label": "Q3", "role": "q", "canBeTriState": false }
    ]
  },

  "signalModel": {
    "allowedInputValues": [0, 1],
    "allowedOutputValues": [0, 1],
    "hiZInputHandling": "treated-as-0",
    "busCapable": false
  },

  "exportSupport": {
    "verilog": "full",
    "vhdl": "full",
    "verilogNotes": "always @(posedge clk or posedge rst) if (rst) q<=0; elsif (en) q<=d; assign q_n = ~q (not applicable here).",
    "vhdlNotes": "process(clk, rst) if rst='1' then q<=(others=>'0'); elsif rising_edge(clk) and en='1' then q<=d; end if;",
    "verilogExtraRegs": false,
    "vhdlExtraSignals": false
  },

  "testability": {
    "requiredPatterns": [
      "async-control-override",
      "clock-edge-detection",
      "hold-state",
      "reset-to-known-state",
      "sequential-step-sequence",
      "export-verilog",
      "export-vhdl"
    ],
    "notes": "Verify rst=1 resets all Q to 0 immediately. Verify clk↑+en=1 loads D into Q. Verify en=0 holds state."
  },

  "risks": [],
  "modelLimits": [
    "No metastability modelling.",
    "prevClk hidden state not exposed to STT."
  ]
}
